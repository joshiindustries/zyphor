{
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "VITE_BASE=/ npm run build",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/backend.json", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://cdn.jsdelivr.net; worker-src 'self' blob:; frame-src https://challenges.cloudflare.com; connect-src 'self' https:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
