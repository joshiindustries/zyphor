# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
DESKTOP_AUTH_SECRET=replace-with-at-least-32-characters-for-desktop-jwt
CLOUD_CREDENTIAL_SECRET=replace-with-another-long-random-secret

# OAuth providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
NEXT_PUBLIC_TURNSTILE_ENABLED=false
TURNSTILE_ENFORCE=false

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=uploads

# Prisma / Postgres
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
DATABASE_SSL_NO_VERIFY=false
# Email / error reporting
SMTP_SERVICE=gmail
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-app-password
ERROR_REPORT_EMAIL=your-alert-inbox@example.com
ERROR_REPORT_EMAILS=true

# Release metadata shown on install/update screens
NEXT_PUBLIC_APP_VERSION=5.21.33
NEXT_PUBLIC_APP_COMMIT=local
NEXT_PUBLIC_BUILD_TIME=
